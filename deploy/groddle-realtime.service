# systemd unit for the realtime server on a Linux host (the live site's machine).
# Install: copy the binary to /opt/groddle-realtime/, the secret to /etc/groddle/realtime.secret
# (owned by root, mode 0640, group groddle), then:
#   useradd --system --no-create-home groddle
#   cp groddle-realtime.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now groddle-realtime
# Caddy on this host passes wss://play.groddleafternoon.com/ws to 127.0.0.1:8793; the site names that
# address with GRODDLE_REALTIME_URL, and -origins lets its pages connect (see readme.md).
[Unit]
Description=Groddle Afternoon realtime server
After=network-online.target
Wants=network-online.target

[Service]
User=groddle
Group=groddle
# -ledger-url is the site trades settle in (ledger.go); with a public certificate no -ledger-ca is needed.
# Every state file goes in the StateDirectory: /etc is read-only here (ProtectSystem=strict), so the
# default beside -secret-file would not do (persist.go lists the files).
# -patches on (since v0.18.0): shared street Patches (patches.go, G564); -patches off turns them dark again. -patches-seed is the payout's winners
# (patches_seed.go): the release copies tools/patches/payout.mjs --seed-out's file there before the restart;
# with no file there is nothing to plant.
ExecStart=/opt/groddle-realtime/groddle-realtime -addr 127.0.0.1:8793 -secret-file /etc/groddle/realtime.secret -ledger-url https://groddleafternoon.com -origins groddleafternoon.com \
  -trade-journal /var/lib/groddle-realtime/realtime-trades.jsonl -projects-file /var/lib/groddle-realtime/realtime-projects.json \
  -feats-file /var/lib/groddle-realtime/realtime-feats.json -hi-file /var/lib/groddle-realtime/realtime-hi.json \
  -credits-file /var/lib/groddle-realtime/realtime-credits.jsonl -objects-file /var/lib/groddle-realtime/realtime-objects.json \
  -gardens-file /var/lib/groddle-realtime/realtime-gardens.json -patches on -patches-file /var/lib/groddle-realtime/realtime-patches.json \
  -patches-seed /var/lib/groddle-realtime/realtime-patches-seed.json \
  -rook-file /var/lib/groddle-realtime/realtime-rook.json -quoins-file /var/lib/groddle-realtime/realtime-quoins.json \
  -crowns-file /var/lib/groddle-realtime/realtime-crowns.json -mayhem-file /var/lib/groddle-realtime/realtime-mayhem.json -party-file /var/lib/groddle-realtime/realtime-party.json \
  -bans-file /var/lib/groddle-realtime/realtime-bans.json -uses-file /var/lib/groddle-realtime/realtime-uses.json -toys-file /var/lib/groddle-realtime/realtime-toys.json \
  -proofs-file /var/lib/groddle-realtime/realtime-proofs.jsonl -im-file /var/lib/groddle-realtime/realtime-im.json -chat-store-file /var/lib/groddle-realtime/realtime-chat-store.json \
  -play-time-file /var/lib/groddle-realtime/realtime-play-time.json -chatlog-dir /var/lib/groddle-realtime/chatlog -chatlog-days 30 -health-dir /var/lib/groddle-realtime/health
Restart=always
RestartSec=2
# SIGTERM closes the listener and lets sockets finish (main.go).
KillSignal=SIGTERM
TimeoutStopSec=15
StateDirectory=groddle-realtime
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
